            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "tldlookup",
        "tld lookup",
        "top level domain",
        "domain extension",
        "tld api",
        "domain type"
    ],
    "homepage": "https://apiverve.com/marketplace/tldlookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/tldlookup",
        "source": "https://github.com/apiverve/tldlookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Tldlookup\\": "php/src/"
        }
    },
    "autoload-dev": {
